# Copie para .env e preencha localmente. Nunca publique a conexão real.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require&channel_binding=require
# Sem DATABASE_URL, o backend pode ser executado em modo local JSON.
MEW_HOST=127.0.0.1
MEW_PORT=8000
# Em HTTPS use true. Para desenvolvimento local em HTTP, use false.
# MEW_COOKIE_SECURE=false
# MEW_ADMIN_TOKEN=chave_da_equipe_com_pelo_menos_24_caracteres
